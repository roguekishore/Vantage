# Spring Boot 4.x requires GraalVM for JDK 25+ for native images.
# Boot checks this at RUNTIME, not build time — a JDK 17 build succeeds
# and then fails at startup with NativeImageRequirementsException.
FROM ghcr.io/graalvm/native-image-community:25 AS build
RUN microdnf install -y curl tar gzip && microdnf clean all \
    && curl -fsSL https://archive.apache.org/dist/maven/maven-3/3.9.11/binaries/apache-maven-3.9.11-bin.tar.gz \
       | tar -xz -C /opt \
    && ln -s /opt/apache-maven-3.9.11/bin/mvn /usr/local/bin/mvn
WORKDIR /app
COPY pom.xml .
RUN mvn dependency:go-offline -q
COPY src ./src
RUN mvn clean package -Pnative -DskipTests

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates && rm -rf /var/lib/apt/lists/*
RUN groupadd --system app && useradd --system --gid app --home-dir /app app
WORKDIR /app
# Set ownership/mode during the copy. A separate `RUN chown -R` would rewrite
# every byte of the 176MB binary into a second layer (layers are copy-on-write),
# roughly doubling the image.
COPY --from=build --chown=app:app --chmod=755 /app/target/vantage app
USER app
EXPOSE 8080
ENTRYPOINT ["./app"]
